<?xml version="1.0" encoding="utf-8"?>
<!-- Адаптивная иконка (Android 8+). Фон — плоский цвет, а не PNG: лаунчер
     двигает слои друг относительно друга, и растровому фону пришлось бы быть
     заведомо больше кадра, чтобы при сдвиге не показался край.

     Для тематической иконки Android 13 прозрачный экран отделяет силуэт
     буквы от корпуса. Лаунчер сам окрашивает непрозрачные пиксели. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
