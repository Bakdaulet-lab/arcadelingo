# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.vscode/*
!.vscode/settings.json

# Android
android/.gradle/
android/local.properties
android/key.properties
*.keystore
*.jks

# iOS / macOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
**/*.mobileprovision
**/*.p12
.DS_Store

# Секреты и локальное окружение
.env
.env.*
!.env.example

# Артефакты тестов
test/**/failures/
# Кандидат в эталоны: его смотрит человек и переименовывает руками, если вид
# верный. Хранить незачем — docs/dev/goldens.md
test/golden/images/*.new.png

# Снимки экранов из test/peek/. Их делают, чтобы посмотреть и приложить к
# задаче, а не чтобы хранить: у голденов для этого своя процедура и свой
# каталог. Здесь же лежит граница, которая не даёт снимку стать эталоном.
test/peek/out/
coverage/

# Claude Code: локальные настройки не коммитим, проектные — коммитим
.claude/settings.local.json

# Трек К: рабочие файлы импортёра. Порции регенерируются из CSV одной командой,
# а принятое живёт в assets/words_seed.json — держать их в истории незачем.
# Исключение — rejected.json: причины отказов копятся в калибровку генератора
# обманок (К3) и обязаны пережить регенерацию. Игнорируем содержимое каталога,
# а не сам каталог: из исключённого каталога файл обратно уже не вернуть.
tool/out/*
!tool/out/rejected.json
