# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
.vscode/*
!.vscode/settings.json

# Android
android/.gradle/
android/local.properties

# Релизная подпись. Эти три строки стоят здесь до того, как появился хоть один
# такой файл, и это не запас на будущее: ключ, однажды попавший в историю git,
# компрометирует подпись навсегда — отозвать её нельзя, а сменить после
# публикации не даёт Play.
#
# Те же имена перечислены и в android/.gitignore (он из шаблона Flutter), и
# дублирование намеренное: шаблонный файл закрывает только своё поддерево, а
# хранилище кладут куда угодно — этот закрывает остальное дерево. Для секрета,
# который нельзя отозвать, два независимых правила дешевле одного.
#
# Проверяет их не глаз, а сам git: тест test/android/release_signing_test.dart
# спрашивает `git check-ignore` про каждый путь и требует, чтобы ничего
# похожего не было в индексе. Что и куда класть — docs/dev/release.md
android/key.properties
*.keystore
*.jks

# iOS / macOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
**/*.mobileprovision
**/*.p12
.DS_Store

# Секреты и локальное окружение
.env
.env.*
!.env.example

# Артефакты тестов
test/**/failures/
# Кандидат в эталоны: его смотрит человек и переименовывает руками, если вид
# верный. Хранить незачем — docs/dev/goldens.md
test/golden/images/*.new.png

# Снимки экранов из test/peek/. Их делают, чтобы посмотреть и приложить к
# задаче, а не чтобы хранить: у голденов для этого своя процедура и свой
# каталог. Здесь же лежит граница, которая не даёт снимку стать эталоном.
test/peek/out/
coverage/

# Claude Code: локальные настройки не коммитим, проектные — коммитим
.claude/settings.local.json

# Трек К: рабочие файлы импортёра. Порции регенерируются из CSV одной командой,
# а принятое живёт в assets/words_seed.json — держать их в истории незачем.
# Исключение — rejected.json: причины отказов копятся в калибровку генератора
# обманок (К3) и обязаны пережить регенерацию. Игнорируем содержимое каталога,
# а не сам каталог: из исключённого каталога файл обратно уже не вернуть.
tool/out/*
!tool/out/rejected.json

# Превью иконок: их пересоздаёт tool/brand/render_icons.dart за секунду.
# В репозиторий едет только то, что попадает в сборку, — android/ и ios/
tool/out/icons/

# Байткод Python: появляется, если scripts/mutate.py импортировать модулем
__pycache__/
